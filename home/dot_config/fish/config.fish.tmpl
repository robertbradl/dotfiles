if status is-interactive
    # Commands to run in interactive sessions can go here
end

function fish_greeting
    echo " - Welcome Robert!"
end

eval "$(pyenv init -)"
eval "$(/opt/homebrew/bin/brew shellenv)"

bind --preset \cC cancel-commandline

alias vim="nvim"
alias cat="bat"
alias z="zoxide"
alias ls="eza --icons=always"
alias finder="open -a Finder ."
alias aerc="aerc -C ~/.config/aerc/aerc.conf -A ~/.config/aerc/accounts.conf -B ~/.config/aerc/binds.conf"
 
{{ if eq .colorScheme "Rose Pine" }}
fish_config theme choose "Rosé Pine Moon"
{{ else if eq .colorScheme "Ayu" }}
fish_config theme choose "ayu Mirage"
{{ else if eq .colorScheme "Catppuccin" }}
fish_config theme choose "Catppuccin Mocha"
{{ else }}
fish_config theme choose Lava
{{ end }}

set -gx VISUAL nvim
set -gx EDITOR nvim
set -gx FZF_DEFAULT_OPTS '--style full --color=fg:#ebdbb2,hl:#b16286 --color=fg+:#689d6a,hl+:#d3869b --color=info:#d65d0e,prompt:#458588,pointer:#fe8019 --color=marker:#8ec07c,spinner:#cc241d,header:#fabd2f'

zoxide init fish | source
rvm default
